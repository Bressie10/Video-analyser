{
  "name": "video-analyzer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:company": "node --test tests/company-state.test.mjs",
    "test:e2e": "node --test tests/flow.test.mjs tests/meta-status.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:companies": "node --test tests/company.test.mjs",
    "test:company-integration": "node --test tests/company-integration.test.mjs",
    "test:generation": "node --test tests/generation.test.mjs",
    "test:ideas": "node --test tests/ideas-api.test.mjs tests/ideas.test.mjs",
    "test:wave2-integration": "node --test tests/wave2-integration.test.mjs",
    "test:content-settings": "node --test tests/content-settings.test.mjs",
    "test:legal": "node --test tests/legal.test.mjs",
    "test:foundation": "node --test tests/foundation.test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
