POSTGRES_USER=video_analyzer
POSTGRES_PASSWORD=video_analyzer
POSTGRES_DB=video_analyzer
POSTGRES_PORT=5432
# Backend role must own application tables or have BYPASSRLS and SQL privileges.
DATABASE_URL=postgresql://video_analyzer:video_analyzer@localhost:5432/video_analyzer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

META_APP_ID=
META_APP_SECRET=
# Use the frontend proxy origin so state/session cookies remain same-origin.
# Production: https://video-analyser-nu.vercel.app/api/meta/callback
META_REDIRECT_URI=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# Required for automatic persistent Meta library sync. Set a Fernet key in the
# server environment; keep it stable across restarts and out of source control.
META_TOKEN_ENCRYPTION_KEY=
# One analysis worker and two provider workers, coordinated through PostgreSQL.
META_WORKER_ENABLED=true

# Supabase Auth asymmetric JWT verification (server only; no signing secret).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Run one API process AND one instance while OAuth state is process-local.
# See V6_INTEGRATION.md; provider/background worker settings are separate.

# Server-side Stripe Billing. APP_ORIGIN is the current deployed frontend HTTPS origin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
APP_ORIGIN=
# Optional: true only after Stripe Tax and Product configuration are ready.
STRIPE_AUTOMATIC_TAX=
